+class _OffloadGroupProjection:
+    """Exclude reconstructible scratch rings from the connector's cache view.
+
+    The GPU scheduler retains the complete layout. All connector-facing group
+    arrays use the same compact index mapping, including resumed requests and
+    Mamba boundary handoffs. Physical block IDs remain unchanged.
+    """
+
+    def __init__(self, config):
+        self.indices = tuple(i for i, g in enumerate(config.kv_cache_groups)
+                             if g.kv_cache_spec.prefix_cacheable)
+        self.changed = len(self.indices) != len(config.kv_cache_groups)
+        self.reverse = {original: compact for compact, original in enumerate(self.indices)}
+        for g in config.kv_cache_groups:
+            if not g.kv_cache_spec.prefix_cacheable:
+                if not all(isinstance(spec, (CircularBufferSpec, KpoolTailSpec))
+                           for spec in iter_layer_specs(g.kv_cache_spec)):
+                    raise NotImplementedError("Offloading cannot omit an unknown non-cacheable group")
+        if not self.indices:
+            raise ValueError("No prefix-cacheable groups to offload")
+        self.config = replace(config, kv_cache_groups=[config.kv_cache_groups[i] for i in self.indices]) if self.changed else config
+
+    def select(self, groups):
+        if groups is None or not self.changed:
+            return groups
+        return tuple(groups[i] for i in self.indices)
+
+    def scheduler_output(self, output):
+        if not self.changed:
+            return output
+        state = output.kv_connector_block_state
+        if state is not None:
+            original_state = state
+            state = replace(state,
+                resolve_block_ids=lambda req_id: self.select(original_state.resolve_block_ids(req_id)),
+                boundary_state_offloads={req_id: [(self.reverse[g], block, boundary)
+                    for g, block, boundary in entries if g in self.reverse]
+                    for req_id, entries in state.boundary_state_offloads.items()})
+        return replace(output,
+            scheduled_new_reqs=[replace(req, block_ids=self.select(req.block_ids))
+                                for req in output.scheduled_new_reqs],
+            scheduled_cached_reqs=replace(output.scheduled_cached_reqs,
+                new_block_ids=[self.select(groups) for groups in output.scheduled_cached_reqs.new_block_ids]),
+            kv_connector_block_state=state)
 
 
